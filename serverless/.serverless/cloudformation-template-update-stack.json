    "ApiLambdaVersioni0ByQjb6bZDoI0dtOsC64YrcH4JthRzd79ewtH36yE": {
      "Type": "AWS::Lambda::Version",
      "DeletionPolicy": "Retain",
      "Properties": {
        "FunctionName": {
          "Ref": "ApiLambdaFunction"
        },
        "CodeSha256": "lL73a67C3DfjgneN6wW3r5wNg9RLdBq3C+xgWDK/5io="
      }
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
