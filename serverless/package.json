{
  "name": "hishalom-worship-backend",
  "version": "2.0.0",
  "description": "하이샬롬 예배자동화 Serverless Backend",
  "main": "handler.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "serverless offline start --stage dev",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "deploy:win:dev": "powershell -ExecutionPolicy Bypass -File deploy.ps1 dev",
    "deploy:win:prod": "powershell -ExecutionPolicy Bypass -File deploy.ps1 prod",
    "remove": "serverless remove",
    "logs": "serverless logs -f api -t"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/client-dynamodb": "^3.490.0",
    "@aws-sdk/lib-dynamodb": "^3.490.0",
    "@aws-sdk/client-transcribe": "^3.490.0",
    "aws-lambda": "^1.0.7",
    "express": "^4.18.2",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "serverless": "^3.38.0",
    "serverless-offline": "^13.3.0"
  },
  "keywords": [
    "serverless",
    "aws",
    "lambda",
    "dynamodb",
    "s3",
    "worship",
    "church"
  ],
  "author": "김완중집사",
  "license": "MIT"
}
