# 하이샬롬 예배자동화 Serverless Backend 환경 변수
# Node.js 20.x 이상 필요

# AWS 설정
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# S3 설정
S3_BUCKET_NAME=hishalom-data

# 프론트엔드 URL
FRONTEND_URL=https://worship.iampam.io

# DynamoDB 테이블 (자동 생성됨)
# DYNAMODB_TABLE=worship

# 기본 교회 정보 (DynamoDB에 자동 저장됨)
# - 교회명: hishalom
# - 관리자 비밀번호: hishalom

# 추가 교회 정보는 DynamoDB에 저장되며, API를 통해 관리됩니다.
# POST /api/churches - 교회 추가
# PUT /api/churches/:churchName/password - 비밀번호 변경
# GET /api/churches - 교회 목록 조회 